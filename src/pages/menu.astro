---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Launch Discount Banner -->
  <div class="discount-banner">
    <div class="sparkle-effect">✨</div>
    <span>🎉 Launch Discount: Get Up to 60% Off! 🎉</span>
    <div class="sparkle-effect">✨</div>
  </div>

  <header class="site-header">
    <div class="container">
      <a class="brand" href="/">Litterateur</a>
      <nav class="nav">
        <a href="/menu">Menu</a>
        <a href="/rewards">Rewards</a>
        <a class="cta" href="/otp-login">Sign In</a>
      </nav>
      <div class="cart-icon">
        🛒 <span class="cart-count">0</span>
      </div>
    </div>
  </header>

  <main>
    <section class="menu-header">
      <div class="container">
        <h1>Our Menu</h1>
        <p>Discover our carefully crafted selection of gourmet dishes and artisan beverages</p>
      </div>
    </section>

    <!-- Category Filters -->
    <section class="menu-filters">
      <div class="container">
        <div class="filter-buttons">
          <button class="filter-btn active" data-category="all">All Items</button>
          <button class="filter-btn" data-category="breakfast">Breakfast</button>
          <button class="filter-btn" data-category="lunch">Lunch</button>
          <button class="filter-btn" data-category="dinner">Dinner</button>
          <button class="filter-btn" data-category="beverages">Beverages</button>
          <button class="filter-btn" data-category="desserts">Desserts</button>
        </div>
      </div>
    </section>

    <!-- Menu Grid -->
    <section class="menu-grid">
      <div class="container">
        <div class="menu-items">
          <!-- Breakfast Items -->
          <div class="menu-item" data-category="breakfast">
            <div class="menu-image">🥐</div>
            <span class="badge bestseller">Bestseller</span>
            <div class="menu-details">
              <h3>Artisan Croissant</h3>
              <p>Buttery, flaky perfection with premium French butter and homemade jam</p>
              <div class="menu-footer">
                <span class="price">₹299</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="breakfast">
            <div class="menu-image">🍳</div>
            <span class="badge new">New</span>
            <div class="menu-details">
              <h3>Truffle Scramble</h3>
              <p>Free-range eggs with black truffle, aged cheddar, and fresh herbs</p>
              <div class="menu-footer">
                <span class="price">₹449</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="breakfast">
            <div class="menu-image">🥞</div>
            <div class="menu-details">
              <h3>Classic Pancakes</h3>
              <p>Fluffy buttermilk pancakes with maple syrup and fresh berries</p>
              <div class="menu-footer">
                <span class="price">₹349</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <!-- Lunch Items -->
          <div class="menu-item" data-category="lunch">
            <div class="menu-image">🥗</div>
            <span class="badge bestseller">Bestseller</span>
            <div class="menu-details">
              <h3>Garden Fresh Salad</h3>
              <p>Organic greens, quinoa, avocado, roasted vegetables, house vinaigrette</p>
              <div class="menu-footer">
                <span class="price">₹349</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="lunch">
            <div class="menu-image">🍔</div>
            <div class="menu-details">
              <h3>Gourmet Burger</h3>
              <p>Wagyu beef patty, caramelized onions, aged cheddar, brioche bun</p>
              <div class="menu-footer">
                <span class="price">₹599</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="lunch">
            <div class="menu-image">🍝</div>
            <div class="menu-details">
              <h3>Mushroom Risotto</h3>
              <p>Creamy arborio rice with wild mushrooms, parmesan, white truffle oil</p>
              <div class="menu-footer">
                <span class="price">₹449</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <!-- Dinner Items -->
          <div class="menu-item" data-category="dinner">
            <div class="menu-image">🥩</div>
            <span class="badge bestseller">Bestseller</span>
            <div class="menu-details">
              <h3>Grilled Ribeye</h3>
              <p>Prime cut with herb butter, roasted potatoes, seasonal vegetables</p>
              <div class="menu-footer">
                <span class="price">₹899</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="dinner">
            <div class="menu-image">🍣</div>
            <span class="badge new">New</span>
            <div class="menu-details">
              <h3>Chef's Sushi Platter</h3>
              <p>Fresh salmon, tuna, yellowtail, wasabi, pickled ginger, soy sauce</p>
              <div class="menu-footer">
                <span class="price">₹799</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="dinner">
            <div class="menu-image">🍲</div>
            <div class="menu-details">
              <h3>Lobster Bisque</h3>
              <p>Rich, creamy soup with fresh lobster, brandy, herbs, croutons</p>
              <div class="menu-footer">
                <span class="price">₹449</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <!-- Beverages -->
          <div class="menu-item" data-category="beverages">
            <div class="menu-image">☕</div>
            <span class="badge bestseller">Bestseller</span>
            <div class="menu-details">
              <h3>Signature Blend Coffee</h3>
              <p>Single-origin beans with chocolate and caramel notes, served hot or iced</p>
              <div class="menu-footer">
                <span class="price">₹199</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="beverages">
            <div class="menu-image">🍵</div>
            <div class="menu-details">
              <h3>Artisan Tea Collection</h3>
              <p>Premium loose-leaf teas: Earl Grey, Jasmine, English Breakfast</p>
              <div class="menu-footer">
                <span class="price">₹149</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="beverages">
            <div class="menu-image">🥤</div>
            <span class="badge new">New</span>
            <div class="menu-details">
              <h3>Fresh Smoothies</h3>
              <p>Daily blends: Berry Burst, Tropical Paradise, Green Detox</p>
              <div class="menu-footer">
                <span class="price">₹249</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <!-- Desserts -->
          <div class="menu-item" data-category="desserts">
            <div class="menu-image">🍰</div>
            <span class="badge bestseller">Bestseller</span>
            <div class="menu-details">
              <h3>Chocolate Lava Cake</h3>
              <p>Warm chocolate cake with molten center, vanilla ice cream</p>
              <div class="menu-footer">
                <span class="price">₹299</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="desserts">
            <div class="menu-image">🍮</div>
            <div class="menu-details">
              <h3>Crème Brûlée</h3>
              <p>Classic French custard with caramelized sugar top</p>
              <div class="menu-footer">
                <span class="price">₹249</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>

          <div class="menu-item" data-category="desserts">
            <div class="menu-image">🍨</div>
            <div class="menu-details">
              <h3>Artisan Gelato</h3>
              <p>House-made: Pistachio, Stracciatella, Salted Caramel</p>
              <div class="menu-footer">
                <span class="price">₹199</span>
                <button class="add-to-cart">Add to Cart</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cart Summary (Floating) -->
    <div class="cart-summary" id="cartSummary">
      <div class="cart-header">
        <h3>Your Cart</h3>
        <button class="close-cart">×</button>
      </div>
      <div class="cart-items" id="cartItems">
        <p class="empty-cart">Your cart is empty</p>
      </div>
      <div class="cart-footer">
        <div class="cart-total">
          <span>Total: ₹<span id="cartTotal">0</span></span>
        </div>
        <button class="checkout-btn" disabled>Proceed to Checkout</button>
      </div>
    </div>
  </main>

  <script>
    // Cart functionality
    let cart = [];
    let cartCount = 0;
    const cartCountEl = document.querySelector('.cart-count');
    const cartSummary = document.getElementById('cartSummary');
    const cartItemsEl = document.getElementById('cartItems');
    const cartTotalEl = document.getElementById('cartTotal');

    // Filter functionality
    const filterButtons = document.querySelectorAll('.filter-btn');
    const menuItems = document.querySelectorAll('.menu-item');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.dataset.category;
        
        // Update active button
        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        // Filter items
        menuItems.forEach(item => {
          if (category === 'all' || item.dataset.category === category) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Add to cart functionality
    document.querySelectorAll('.add-to-cart').forEach(button => {
      button.addEventListener('click', (e) => {
        const menuItem = e.target.closest('.menu-item');
        const name = menuItem.querySelector('h3').textContent;
        const price = parseInt(menuItem.querySelector('.price').textContent.replace('₹', ''));
        const image = menuItem.querySelector('.menu-image').textContent;
        
        const cartItem = {
          id: Date.now(),
          name,
          price,
          image,
          quantity: 1
        };
        
        cart.push(cartItem);
        updateCart();
        
        // Show toast notification
        showToast(`${name} added to cart!`);
      });
    });

    function updateCart() {
      cartCount = cart.reduce((total, item) => total + item.quantity, 0);
      cartCountEl.textContent = cartCount;
      
      // Update cart summary
      if (cart.length === 0) {
        cartItemsEl.innerHTML = '<p class="empty-cart">Your cart is empty</p>';
        document.querySelector('.checkout-btn').disabled = true;
      } else {
        cartItemsEl.innerHTML = cart.map(item => `
          <div class="cart-item">
            <span class="cart-item-image">${item.image}</span>
            <div class="cart-item-details">
              <h4>${item.name}</h4>
              <span>₹${item.price}</span>
            </div>
            <div class="cart-item-quantity">
              <button class="quantity-btn minus" data-id="${item.id}">-</button>
              <span>${item.quantity}</span>
              <button class="quantity-btn plus" data-id="${item.id}">+</button>
            </div>
          </div>
        `).join('');
        
        document.querySelector('.checkout-btn').disabled = false;
      }
      
      // Update total
      const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      cartTotalEl.textContent = total;
      
      // Add event listeners to quantity buttons
      document.querySelectorAll('.quantity-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = parseInt(e.target.dataset.id);
          const item = cart.find(item => item.id === id);
          
          if (e.target.classList.contains('plus')) {
            item.quantity++;
          } else if (e.target.classList.contains('minus') && item.quantity > 1) {
            item.quantity--;
          }
          
          updateCart();
        });
      });
    }

    // Cart toggle
    document.querySelector('.cart-icon').addEventListener('click', () => {
      cartSummary.classList.toggle('active');
    });

    document.querySelector('.close-cart').addEventListener('click', () => {
      cartSummary.classList.remove('active');
    });

    // Toast notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    }
  </script>

  <style>
    :root {
      --primary-green: #1B4332;
      --cream-white: #F8F9FA;
      --gold: #FFD700;
      --text-dark: #2C3E50;
      --text-light: #6C757D;
      --border-light: #E9ECEF;
      --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      --shadow-hover: 0 8px 15px rgba(0, 0, 0, 0.2);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Georgia', serif;
      line-height: 1.6;
      color: var(--text-dark);
      background: var(--cream-white);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Discount Banner */
    .discount-banner {
      background: linear-gradient(45deg, var(--gold), #FFA500);
      color: var(--primary-green);
      text-align: center;
      padding: 12px;
      font-weight: bold;
      font-size: 18px;
      position: relative;
      overflow: hidden;
    }

    .sparkle-effect {
      display: inline-block;
      animation: sparkle 2s infinite;
    }

    @keyframes sparkle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }

    /* Header */
    .site-header {
      background: white;
      box-shadow: var(--shadow);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .site-header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
    }

    .brand {
      font-size: 28px;
      font-weight: bold;
      color: var(--primary-green);
      text-decoration: none;
      font-family: 'Playfair Display', serif;
    }

    .nav {
      display: flex;
      gap: 30px;
      align-items: center;
    }

    .nav a {
      color: var(--text-dark);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }

    .nav a:hover {
      color: var(--primary-green);
    }

    .cta {
      background: var(--primary-green);
      color: white;
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .cta:hover {
      background: #2A5F3E;
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .cart-icon {
      position: relative;
      font-size: 24px;
      cursor: pointer;
    }

    .cart-count {
      position: absolute;
      top: -8px;
      right: -8px;
      background: var(--gold);
      color: var(--primary-green);
      border-radius: 50%;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: bold;
    }

    /* Menu Header */
    .menu-header {
      padding: 60px 0;
      text-align: center;
      background: linear-gradient(135deg, var(--cream-white) 0%, #E8F5E8 100%);
    }

    .menu-header h1 {
      font-size: 48px;
      color: var(--primary-green);
      margin-bottom: 20px;
      font-family: 'Playfair Display', serif;
    }

    .menu-header p {
      font-size: 18px;
      color: var(--text-light);
      max-width: 600px;
      margin: 0 auto;
    }

    /* Filters */
    .menu-filters {
      padding: 40px 0;
      background: white;
      border-bottom: 1px solid var(--border-light);
    }

    .filter-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .filter-btn {
      background: white;
      color: var(--text-dark);
      border: 2px solid var(--border-light);
      padding: 12px 24px;
      border-radius: 25px;
      cursor: pointer;
      transition: all 0.3s;
      font-family: inherit;
      font-size: 16px;
    }

    .filter-btn:hover {
      border-color: var(--primary-green);
      color: var(--primary-green);
    }

    .filter-btn.active {
      background: var(--primary-green);
      color: white;
      border-color: var(--primary-green);
    }

    /* Menu Grid */
    .menu-grid {
      padding: 60px 0;
      background: var(--cream-white);
    }

    .menu-items {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 30px;
    }

    .menu-item {
      background: white;
      border-radius: 16px;
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: all 0.3s;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .menu-item:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .menu-image {
      height: 200px;
      background: linear-gradient(45deg, #E8F5E8, #D4E9D4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 64px;
      position: relative;
    }

    .badge {
      position: absolute;
      top: 15px;
      right: 15px;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      color: white;
    }

    .badge.bestseller {
      background: #FF6B6B;
    }

    .badge.new {
      background: var(--gold);
      color: var(--primary-green);
    }

    .menu-details {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .menu-details h3 {
      color: var(--primary-green);
      margin-bottom: 10px;
      font-size: 24px;
    }

    .menu-details p {
      color: var(--text-light);
      margin-bottom: 20px;
      line-height: 1.6;
      flex: 1;
    }

    .menu-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .price {
      font-size: 24px;
      font-weight: bold;
      color: var(--primary-green);
    }

    .add-to-cart {
      background: var(--primary-green);
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s;
    }

    .add-to-cart:hover {
      background: #2A5F3E;
    }

    /* Cart Summary */
    .cart-summary {
      position: fixed;
      right: -400px;
      top: 0;
      width: 400px;
      height: 100vh;
      background: white;
      box-shadow: -4px 0 15px rgba(0, 0, 0, 0.1);
      z-index: 1000;
      transition: right 0.3s ease;
      display: flex;
      flex-direction: column;
    }

    .cart-summary.active {
      right: 0;
    }

    .cart-header {
      padding: 20px;
      border-bottom: 1px solid var(--border-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cart-header h3 {
      color: var(--primary-green);
      font-size: 24px;
    }

    .close-cart {
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: var(--text-light);
    }

    .cart-items {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
    }

    .empty-cart {
      text-align: center;
      color: var(--text-light);
      padding: 40px 0;
    }

    .cart-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid var(--border-light);
    }

    .cart-item-image {
      font-size: 32px;
      width: 60px;
      text-align: center;
    }

    .cart-item-details {
      flex: 1;
    }

    .cart-item-details h4 {
      color: var(--primary-green);
      margin-bottom: 5px;
    }

    .cart-item-details span {
      color: var(--text-dark);
      font-weight: bold;
    }

    .cart-item-quantity {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .quantity-btn {
      width: 30px;
      height: 30px;
      border: 1px solid var(--border-light);
      background: white;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
    }

    .quantity-btn:hover {
      background: var(--primary-green);
      color: white;
      border-color: var(--primary-green);
    }

    .cart-footer {
      padding: 20px;
      border-top: 1px solid var(--border-light);
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      font-size: 24px;
      font-weight: bold;
      color: var(--primary-green);
    }

    .checkout-btn {
      width: 100%;
      background: var(--primary-green);
      color: white;
      border: none;
      padding: 15px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 18px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .checkout-btn:hover:not(:disabled) {
      background: #2A5F3E;
    }

    .checkout-btn:disabled {
      background: var(--text-light);
      cursor: not-allowed;
    }

    /* Toast Notification */
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--primary-green);
      color: white;
      padding: 15px 20px;
      border-radius: 8px;
      box-shadow: var(--shadow-hover);
      z-index: 1001;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .menu-header h1 {
        font-size: 36px;
      }

      .filter-buttons {
        gap: 10px;
      }

      .filter-btn {
        padding: 10px 18px;
        font-size: 14px;
      }

      .menu-items {
        grid-template-columns: 1fr;
      }

      .cart-summary {
        width: 100%;
        right: -100%;
      }

      .nav {
        display: none;
      }
    }
  </style>
</Layout>
