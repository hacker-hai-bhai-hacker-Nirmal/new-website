---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Single scrolling marquee for promo -->
  <marquee class="discount-banner" behavior="scroll" direction="left" scrollamount="8">
    🎉 Launch Offer: Up to 60% OFF! 🎉
  </marquee>

  <header class="site-header">
    <div class="container header-flex">
      <a class="brand" href="/">Litterateur</a>
      <nav class="nav">
        <a href="#featured-menu" class="scroll-link">Menu</a>
        <a href="#how-it-works" class="scroll-link">How It Works</a>
        <a href="#referral" class="scroll-link">Rewards</a>
        <a href="/dashboard" id="account-link" style="display:none">My Account</a>
        <a class="cta" href="/login" id="signin-link">Sign In</a>
        <span class="cart-icon" id="cartIcon" tabindex="0">🛒 <span class="cart-count">0</span></span>
      </nav>
    </div>
  </header>
  <div id="cartOverlay" class="cart-overlay" style="display:none">
    <div class="checkout-drawer">
      <button id="closeCart" class="close-cart">×</button>
      <h2>Order Summary</h2>
      <div class="cart-items" id="cartItems">
        <div class="cart-item">
          <div class="item-image">🥐</div>
          <div class="item-details">
            <h4>Artisan Croissant</h4>
            <p>Buttery, flaky perfection with premium French butter</p>
            <div class="item-controls">
              <button class="quantity-btn minus">-</button>
              <span class="quantity">2</span>
              <button class="quantity-btn plus">+</button>
            </div>
          </div>
          <div class="item-price">₹598</div>
        </div>
        <div class="cart-item">
          <div class="item-image">☕</div>
          <div class="item-details">
            <h4>Signature Blend Coffee</h4>
            <p>Single-origin beans with chocolate and caramel notes</p>
            <div class="item-controls">
              <button class="quantity-btn minus">-</button>
              <span class="quantity">1</span>
              <button class="quantity-btn plus">+</button>
            </div>
          </div>
          <div class="item-price">₹199</div>
        </div>
        <div class="cart-item">
          <div class="item-image">🥗</div>
          <div class="item-details">
            <h4>Garden Fresh Salad</h4>
            <p>Organic greens with house-made vinaigrette</p>
            <div class="item-controls">
              <button class="quantity-btn minus">-</button>
              <span class="quantity">1</span>
              <button class="quantity-btn plus">+</button>
            </div>
          </div>
          <div class="item-price">₹349</div>
        </div>
      </div>
      <div class="discount-summary">
        <h3>Applied Discounts</h3>
        <div class="discount-item">
          <span>Launch Discount Applied:</span>
          <span class="discount-value">-20%</span>
        </div>
        <div class="discount-item">
          <span>Referral Discount:</span>
          <span class="discount-value">-10%</span>
        </div>
        <div class="discount-item">
          <span>Token Discount:</span>
          <span class="discount-value">-5%</span>
        </div>
        <div class="discount-item total">
          <span>Total Discount:</span>
          <span class="discount-value">-35%</span>
        </div>
      </div>
      <div class="price-summary">
        <div class="price-row">
          <span>Subtotal:</span>
          <span>₹1,146</span>
        </div>
        <div class="price-row discount">
          <span>Discount (35%):</span>
          <span>-₹401</span>
        </div>
        <div class="price-row delivery">
          <span>Delivery Fee:</span>
          <span>₹49</span>
        </div>
        <div class="price-row total">
          <span>Grand Total:</span>
          <span>₹794</span>
        </div>
      </div>
      <div class="drawer-address-section">
        <span>Delivering to: <strong>123 Literary Lane</strong></span>
        <button class="change-address">Change</button>
      </div>
      <div class="drawer-footer">
        <a href="/payment" class="proceed-pay-btn">Proceed to Pay (₹794)</a>
      </div>
    </div>
  </div>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background"></div>
      <div class="container">
        <div class="hero-content">
          <h1 class="cafe-name">Litterateur</h1>
          <p class="tagline">Where Culinary Art Meets Literary Excellence</p>
          <p class="lead">Experience gourmet dishes and artisan coffees in an atmosphere that celebrates the written word</p>
          <div class="hero-buttons">
            <a class="primary" href="/menu">Explore Menu</a>
            <a class="secondary" href="#referral">Get Rewards</a>
          </div>
        </div>
        <div class="hero-image">
          <div class="food-placeholder" aria-label="Premium Food Photography" role="img">🍽️ Premium Food Photography</div>
        </div>
      </div>
    </section>

    <!-- Featured Menu Section -->
    <section id="featured-menu" class="featured-menu">
      <div class="container">
        <h2>Featured Menu</h2>
        <div class="featured-grid">
          <div class="menu-card">
            <div class="food-image" aria-label="Artisan Croissant" role="img">🥐</div>
            <span class="badge bestseller">Bestseller</span>
            <h3>Artisan Croissant</h3>
            <p>Buttery, flaky perfection with premium French butter</p>
            <span class="price">₹299</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
          <div class="menu-card">
            <div class="food-image" aria-label="Signature Blend Coffee" role="img">☕</div>
            <span class="badge new">New</span>
            <h3>Signature Blend Coffee</h3>
            <p>Single-origin beans with chocolate and caramel notes</p>
            <span class="price">₹199</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
          <div class="menu-card">
            <div class="food-image" aria-label="Garden Fresh Salad" role="img">🥗</div>
            <h3>Garden Fresh Salad</h3>
            <p>Organic greens with house-made vinaigrette</p>
            <span class="price">₹349</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
        </div>
        <div class="view-all">
          <a href="/menu" class="cta">View Full Menu</a>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="how-it-works">
      <div class="container">
        <h2>How It Works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-icon">📱</div>
            <h3>Browse & Order</h3>
            <p>Explore our menu and place your order in seconds</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-icon">💳</div>
            <h3>Pay Securely</h3>
            <p>Multiple payment options with secure checkout</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-icon">🚚</div>
            <h3>Enjoy Delivery</h3>
            <p>Fresh, hot food delivered to your doorstep</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Referral Rewards Section -->
    <section id="referral" class="referral-section">
      <div class="container">
        <div class="referral-content">
          <h2>Refer Friends & Earn Up to 60% Off!</h2>
          <p>Share Litterateur with your friends and watch your discounts grow</p>
          <div class="referral-steps">
            <div class="referral-step">
              <h4>First Referral</h4>
              <p>20% OFF + 10% Bonus = <strong>30% Total</strong></p>
            </div>
            <div class="referral-step">
              <h4>Keep Sharing</h4>
              <p>Each referral brings you closer to <strong>60% OFF</strong></p>
            </div>
            <div class="referral-step">
              <h4>Friends Win Too</h4>
              <p>Your friends get <strong>20% OFF</strong> their first order</p>
            </div>
          </div>
          <a href="/rewards" class="cta gold">Start Earning Rewards</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h4>Litterateur</h4>
          <p>Where culinary art meets literary excellence</p>
          <div class="social-icons">
            <a href="#">📷 Instagram</a>
            <a href="#">📘 Facebook</a>
            <a href="#">🐦 Twitter</a>
            <a href="#">💬 WhatsApp</a>
          </div>
        </div>
        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/rewards">Rewards</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Contact</h4>
          <p>📍 123 Literary Lane, Cafe District</p>
          <p>📞 +91 98765 43210</p>
          <p>✉️ hello@litterateur.com</p>
        </div>
        <div class="footer-section">
          <h4>Get Exclusive Offers</h4>
          <div class="newsletter">
            <label for="newsletter-email" class="visually-hidden">Email address</label>
            <input id="newsletter-email" type="email" placeholder="Your email" aria-label="Email address">
            <button aria-label="Subscribe to newsletter">Subscribe</button>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <small>&copy; 2025 Litterateur — All rights reserved | Privacy Policy | Terms & Conditions</small>
      </div>
    </div>
  </footer>
</Layout>

<script>
// Cart and address state helpers
const CART_KEY = 'litterateur_cart';
const ADDRESS_KEY = 'litterateur_address';

function getCart() {
  return JSON.parse(localStorage.getItem(CART_KEY) || '[]');
}
function setCart(cart) {
  localStorage.setItem(CART_KEY, JSON.stringify(cart));
}
function getAddress() {
  return localStorage.getItem(ADDRESS_KEY) || '123 Literary Lane';
}
function setAddress(addr) {
  localStorage.setItem(ADDRESS_KEY, addr);
}

// Initial cart data (for demo)
const defaultCart = [
  { id: 1, name: 'Artisan Croissant', desc: 'Buttery, flaky perfection with premium French butter', price: 299, qty: 2, emoji: '🥐' },
  { id: 2, name: 'Signature Blend Coffee', desc: 'Single-origin beans with chocolate and caramel notes', price: 199, qty: 1, emoji: '☕' },
  { id: 3, name: 'Garden Fresh Salad', desc: 'Organic greens with house-made vinaigrette', price: 349, qty: 1, emoji: '🥗' }
];
if (!localStorage.getItem(CART_KEY)) setCart(defaultCart);

function renderCart() {
  const cart = getCart();
  const cartItems = document.getElementById('cartItems');
  const proceedBtn = document.querySelector('.proceed-pay-btn');
  const subtotal = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
  const discount = Math.round(subtotal * 0.35);
  const delivery = cart.length ? 49 : 0;
  const grandTotal = cart.length ? subtotal - discount + delivery : 0;
  // Render items
  if (cart.length === 0) {
    cartItems.innerHTML = `<div class='empty-cart'><p>Your basket is empty.</p><a href='/menu' class='cta'>Browse Menu</a></div>`;
    proceedBtn.style.display = 'none';
  } else {
    cartItems.innerHTML = cart.map((item, i) => `
      <div class="cart-item">
        <div class="item-image">${item.emoji}</div>
        <div class="item-details">
          <h4>${item.name}</h4>
          <p>${item.desc}</p>
          <div class="item-controls">
            <button class="quantity-btn minus" data-idx="${i}">-</button>
            <span class="quantity">${item.qty}</span>
            <button class="quantity-btn plus" data-idx="${i}">+</button>
          </div>
        </div>
        <div class="item-price">₹${item.price * item.qty}</div>
      </div>
    `).join('');
    proceedBtn.style.display = 'block';
  }
  // Update totals
  document.querySelector('.price-summary .price-row:nth-child(1) span:last-child').textContent = `₹${subtotal}`;
  document.querySelector('.price-summary .price-row.discount span:last-child').textContent = `-₹${discount}`;
  document.querySelector('.price-summary .price-row.delivery span:last-child').textContent = `₹${delivery}`;
  document.querySelector('.price-summary .price-row.total span:last-child').textContent = `₹${grandTotal}`;
  proceedBtn.textContent = `Proceed to Pay (₹${grandTotal})`;
  // Update cart count
  document.querySelectorAll('.cart-count').forEach(el => el.textContent = cart.reduce((sum, i) => sum + i.qty, 0));
}

document.addEventListener('click', function(e) {
  if (e.target.classList.contains('plus') || e.target.classList.contains('minus')) {
    const idx = +e.target.dataset.idx;
    const cart = getCart();
    if (e.target.classList.contains('plus')) cart[idx].qty++;
    if (e.target.classList.contains('minus') && cart[idx].qty > 1) cart[idx].qty--;
    if (e.target.classList.contains('minus') && cart[idx].qty === 1) cart.splice(idx, 1);
    setCart(cart);
    renderCart();
  }
});

// Address change
const addressSpan = document.querySelector('.drawer-address-section strong');
const changeBtn = document.querySelector('.change-address');
changeBtn.onclick = function() {
  const newAddr = prompt('Enter delivery address:', getAddress());
  if (newAddr) {
    setAddress(newAddr);
    addressSpan.textContent = newAddr;
  }
};
addressSpan.textContent = getAddress();

// Cart drawer open/close
const cartIcon = document.getElementById('cartIcon');
const cartOverlay = document.getElementById('cartOverlay');
const closeCart = document.getElementById('closeCart');
cartIcon && cartIcon.addEventListener('click', () => {
  cartOverlay.style.display = 'flex';
  renderCart();
});
closeCart && closeCart.addEventListener('click', () => {
  cartOverlay.style.display = 'none';
});
cartOverlay && cartOverlay.addEventListener('click', (e) => {
  if (e.target === cartOverlay) cartOverlay.style.display = 'none';
});

// Auto-open drawer on Add to Cart
function setupAddToCart() {
  document.querySelectorAll('.add-to-cart').forEach((btn, i) => {
    btn.onclick = function() {
      const cart = getCart();
      // Find by name (for demo)
      const name = btn.parentElement.querySelector('h3').textContent;
      const found = cart.find(item => item.name === name);
      if (found) found.qty++;
      else cart.push({
        id: Date.now(),
        name,
        desc: btn.parentElement.querySelector('p').textContent,
        price: +btn.parentElement.querySelector('.price').textContent.replace(/[^\d]/g, ''),
        qty: 1,
        emoji: btn.parentElement.querySelector('.food-image').textContent.trim()
      });
      setCart(cart);
      renderCart();
      cartOverlay.style.display = 'flex';
    };
  });
}
setupAddToCart();

// On page load, render cart
renderCart();
</script>

<style>
  :root {
    --primary-green: #388e3c;
    --cream-white: #F5E6D3;
    --gold: #ffd700;
    --text-dark: #000;
  }
  .discount-banner {
    background: var(--gold);
    color: var(--primary-green);
    text-align: center;
    font-weight: bold;
    font-size: 1.3rem;
    padding: 0.5rem 0;
    margin-bottom: 0;
    border-radius: 0;
    position: relative;
    z-index: 20;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
  }
  .site-header {
    background: var(--cream-white);
    color: var(--text-dark);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    margin: 0;
    width: 100%;
    border-radius: 0;
    position: relative;
    z-index: 10;
    text-align: left;
    padding: 0.5rem 0;
  }
  .header-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .site-header .brand {
    color: var(--text-dark);
    font-weight: bold;
    font-size: 2rem;
    text-decoration: none;
    margin-right: 2rem;
  }
  .site-header .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .site-header .nav a {
    color: var(--text-dark);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .site-header .nav a:hover,
  .site-header .nav .cta {
    color: var(--primary-green);
    background: #e0e0e0;
  }
  .cart-icon {
    color: var(--text-dark);
    font-size: 1.2rem;
    margin-left: 1.5rem;
    display: flex;
    align-items: center;
  }
  .cart-overlay {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    z-index: 1000;
    backdrop-filter: blur(2px);
    transition: background 0.3s;
    /* Prevent background scroll when overlay is open */
    overflow: hidden;
  }
  .checkout-drawer {
    width: 400px;
    max-width: 100vw;
    height: 100vh;
    background: #fff;
    box-shadow: -4px 0 24px rgba(0,0,0,0.12);
    position: fixed;
    right: 0;
    top: 0;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(.4,0,.2,1);
    display: flex;
    flex-direction: column;
    z-index: 1001;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    /* Prevent page scroll when drawer is open */
    overscroll-behavior: contain;
  }
  .cart-overlay[style*="display: flex"] .checkout-drawer {
    transform: translateX(0);
  }
  .close-cart {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
  }
  .drawer-address-section {
    margin-top: auto;
    padding: 1rem 1.5rem;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #eee;
    font-size: 1rem;
    position: sticky;
    bottom: 64px;
    z-index: 2;
  }
  .drawer-footer {
    position: sticky;
    bottom: 0;
    width: 100%;
    background: #fff;
    padding: 1rem 1.5rem;
    box-shadow: 0 -2px 8px rgba(0,0,0,0.04);
    z-index: 3;
  }
  .proceed-pay-btn {
    display: block;
    width: 100%;
    background: #388e3c;
    color: #fff;
    font-size: 1.2rem;
    font-weight: bold;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s;
  }
  .proceed-pay-btn:hover {
    background: #256029;
  }
  @media (max-width: 600px) {
    .checkout-drawer {
      width: 100vw;
      border-radius: 0;
    }
  }
  @media (max-width: 900px) {
    .header-flex {
      flex-direction: column;
      align-items: flex-start;
      padding: 0 1rem;
    }
    .site-header .nav {
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    .site-header .brand {
      margin-bottom: 0.5rem;
    }
  }
  /* Homepage-specific styles */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--primary-green) 0%, #2c5f2d 100%);
    z-index: -1;
  }

  .hero-content {
    flex: 1;
    color: white;
    z-index: 1;
  }

  .hero-image {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .food-placeholder {
    font-size: 4rem;
    opacity: 0.8;
  }

  .featured-menu {
    padding: 5rem 0;
    background: var(--section-light);
    color: var(--text-dark);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .menu-card {
    background: #fff;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
    color: var(--text-dark);
  }

  .menu-card:hover {
    transform: translateY(-5px);
  }

  .food-image {
    font-size: 3rem;
    text-align: center;
    margin-bottom: 1rem;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .badge.bestseller {
    background: #ff4757;
    color: white;
  }

  .badge.new {
    background: var(--gold);
    color: var(--text-dark);
  }

  .price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-green);
    margin: 1rem 0;
  }

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  .how-it-works {
    padding: 5rem 0;
    background: var(--section-light);
    color: var(--text-dark);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
  }

  .step {
    text-align: center;
    background: #fff;
    color: var(--text-dark);
    border-radius: 15px;
    padding: 2rem 1rem;
  }

  .step-number {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--primary-green);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin: 0 auto 1rem;
  }

  .step-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .referral-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, var(--primary-green) 0%, #2c5f2d 100%);
    color: white;
  }

  .referral-content {
    text-align: center;
  }

  .referral-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .referral-step {
    background: rgba(245,230,211,0.7);
    padding: 2rem;
    border-radius: 15px;
    backdrop-filter: blur(10px);
    color: var(--text-dark);
  }

  .cta.gold {
    background: var(--gold);
    color: var(--text-dark);
  }

  .cta.gold:hover {
    background: #ffcc00;
