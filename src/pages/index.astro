---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Launch Discount Banner -->
  <div class="discount-banner">
  </div>

  <header class="site-header">
    <div class="container header-container">
      <a class="brand" href="/">Litterateur</a>
      <nav class="nav">
        <a href="#featured-menu">Menu</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#referral">Rewards</a>
        <a href="/dashboard">My Account</a>
        <a class="cta" href="/login">Sign In</a>
      </nav>
      <div class="cart-icon">
        🛒 <span class="cart-count">0</span>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background"></div>
      <div class="container">
        <div class="hero-content">
          <h1 class="cafe-name">Litterateur</h1>
          <p class="tagline">Where Culinary Art Meets Literary Excellence</p>
          <p class="lead">Experience gourmet dishes and artisan coffees in an atmosphere that celebrates the written word</p>
          <div class="hero-buttons">
            <a class="primary" href="/menu">Explore Menu</a>
            <a class="secondary" href="#referral">Get Rewards</a>
          </div>
        </div>
        <div class="hero-image">
          <div class="food-placeholder" aria-label="Premium Food Photography" role="img">🍽️ Premium Food Photography</div>
        </div>
      </div>
    </section>

    <!-- Featured Menu Section -->
    <section id="featured-menu" class="featured-menu">
      <div class="container">
        <h2>Featured Menu</h2>
        <div class="featured-grid">
          <div class="menu-card">
            <div class="food-image" aria-label="Artisan Croissant" role="img">🥐</div>
            <span class="badge bestseller">Bestseller</span>
            <h3>Artisan Croissant</h3>
            <p>Buttery, flaky perfection with premium French butter</p>
            <span class="price">₹299</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
          <div class="menu-card">
            <div class="food-image" aria-label="Signature Blend Coffee" role="img">☕</div>
            <span class="badge new">New</span>
            <h3>Signature Blend Coffee</h3>
            <p>Single-origin beans with chocolate and caramel notes</p>
            <span class="price">₹199</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
          <div class="menu-card">
            <div class="food-image" aria-label="Garden Fresh Salad" role="img">🥗</div>
            <h3>Garden Fresh Salad</h3>
            <p>Organic greens with house-made vinaigrette</p>
            <span class="price">₹349</span>
            <button class="add-to-cart">Add to Cart</button>
          </div>
        </div>
        <div class="view-all">
          <a href="/menu" class="cta">View Full Menu</a>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="how-it-works">
      <div class="container">
        <h2>How It Works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-icon">📱</div>
            <h3>Browse & Order</h3>
            <p>Explore our menu and place your order in seconds</p>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-icon">💳</div>
            <h3>Pay Securely</h3>
            <p>Multiple payment options with secure checkout</p>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-icon">🚚</div>
            <h3>Enjoy Delivery</h3>
            <p>Fresh, hot food delivered to your doorstep</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Referral Rewards Section -->
    <section id="referral" class="referral-section">
      <div class="container">
        <div class="referral-content">
          <h2>Refer Friends & Earn Up to 60% Off!</h2>
          <p>Share Litterateur with your friends and watch your discounts grow</p>
          <div class="referral-steps">
            <div class="referral-step">
              <h4>First Referral</h4>
              <p>20% OFF + 10% Bonus = <strong>30% Total</strong></p>
            </div>
            <div class="referral-step">
              <h4>Keep Sharing</h4>
              <p>Each referral brings you closer to <strong>60% OFF</strong></p>
            </div>
            <div class="referral-step">
              <h4>Friends Win Too</h4>
              <p>Your friends get <strong>20% OFF</strong> their first order</p>
            </div>
          </div>
          <a href="/rewards" class="cta gold">Start Earning Rewards</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h4>Litterateur</h4>
          <p>Where culinary art meets literary excellence</p>
          <div class="social-icons">
            <a href="#">📷 Instagram</a>
            <a href="#">📘 Facebook</a>
            <a href="#">🐦 Twitter</a>
            <a href="#">💬 WhatsApp</a>
          </div>
        </div>
        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/rewards">Rewards</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>Contact</h4>
          <p>📍 123 Literary Lane, Cafe District</p>
          <p>📞 +91 98765 43210</p>
          <p>✉️ hello@litterateur.com</p>
        </div>
        <div class="footer-section">
          <h4>Get Exclusive Offers</h4>
          <div class="newsletter">
            <label for="newsletter-email" class="visually-hidden">Email address</label>
            <input id="newsletter-email" type="email" placeholder="Your email" aria-label="Email address">
            <button aria-label="Subscribe to newsletter">Subscribe</button>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <small>&copy; 2025 Litterateur — All rights reserved | Privacy Policy | Terms & Conditions</small>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Cart functionality with TypeScript types
  let cartCount: number = 0;
  const cartCountElement: HTMLElement | null = document.querySelector('.cart-count');
  
  // Type the button as HTMLButtonElement since we know it's a button
  document.querySelectorAll<HTMLButtonElement>('.add-to-cart').forEach((button: HTMLButtonElement) => {
    button.addEventListener('click', (event: MouseEvent): void => {
      event.preventDefault();
      cartCount++;
      
      if (cartCountElement) {
        cartCountElement.textContent = cartCount.toString();
      }
      
      // Show toast notification with type safety
      const toast: HTMLDivElement = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = 'Added to cart!';
      document.body.appendChild(toast);
      
      // Remove toast after delay
      const toastTimeout = setTimeout((): void => {
        if (document.body.contains(toast)) {
          document.body.removeChild(toast);
        }
        clearTimeout(toastTimeout);
      }, 2000);
    });
  });

  // Smooth scrolling for anchor links with proper typing
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor: HTMLAnchorElement): void => {
    anchor.addEventListener('click', (event: MouseEvent): void => {
      event.preventDefault();
      
      const targetId: string | null = anchor.getAttribute('href');
      if (!targetId) return;
      
      const targetElement: HTMLElement | null = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Deployment notice close button with null checks
  const noticeClose: HTMLElement | null = document.getElementById('noticeClose');
  const deploymentNotice: HTMLElement | null = document.getElementById('deploymentNotice');
  
  if (noticeClose && deploymentNotice) {
    noticeClose.addEventListener('click', () => {
      deploymentNotice.style.display = 'none';
      localStorage.setItem('deploymentNoticeClosed', 'true');
    });
    
    // Check if notice was previously closed
    if (localStorage.getItem('deploymentNoticeClosed') === 'true') {
      deploymentNotice.style.display = 'none';
    }
  }
</script>

<style>
  :root {
    --primary-green: #388e3c;
    --cream-white: #F5E6D3;
    --gold: #ffd700;
    --text-dark: #000;
  }
  .discount-banner {
    background: var(--gold);
    color: var(--text-dark);
    text-align: center;
    font-weight: bold;
    font-size: 1.3rem;
    padding: 0.5rem 0;
    margin-bottom: 0;
    border-radius: 0;
  }
  .site-header {
    background: var(--cream-white);
    color: var(--text-dark);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    margin: 0 auto;
    width: 100%;
    max-width: 700px;
    border-radius: 0 0 24px 24px;
    position: relative;
    top: -8px;
    z-index: 10;
    text-align: center;
    padding: 0.5rem 0;
  }
  .header-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 0.5rem 1rem;
  }
  .site-header .brand {
    color: var(--text-dark);
    font-weight: bold;
    font-size: 2rem;
    text-decoration: none;
    margin-bottom: 0.5rem;
  }
  .site-header .nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .site-header .nav a {
    color: var(--text-dark);
    font-weight: 500;
    text-decoration: none;
    margin: 0 1rem;
    transition: color 0.2s;
  }
  .site-header .nav a:hover,
  .site-header .nav .cta {
    color: var(--primary-green);
    background: #e0e0e0;
    border-radius: 6px;
  }
  .cart-icon {
    color: var(--text-dark);
    font-size: 1.2rem;
    margin-left: 0;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 900px) {
    .site-header {
      max-width: 100vw;
      border-radius: 0;
    }
    .header-container {
      flex-direction: column;
      gap: 1rem;
      padding: 0.5rem;
    }
    .site-header .nav {
      flex-wrap: wrap;
      justify-content: center;
    }
    .site-header .nav a {
      margin: 0.5rem;
    }
  }
  /* Homepage-specific styles */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--primary-green) 0%, #2c5f2d 100%);
    z-index: -1;
  }

  .hero-content {
    flex: 1;
    color: white;
    z-index: 1;
  }

  .hero-image {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .food-placeholder {
    font-size: 4rem;
    opacity: 0.8;
  }

  .featured-menu {
    padding: 5rem 0;
    background: var(--section-light);
    color: var(--text-dark);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .menu-card {
    background: #fff;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
    color: var(--text-dark);
  }

  .menu-card:hover {
    transform: translateY(-5px);
  }

  .food-image {
    font-size: 3rem;
    text-align: center;
    margin-bottom: 1rem;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .badge.bestseller {
    background: #ff4757;
    color: white;
  }

  .badge.new {
    background: var(--gold);
    color: var(--text-dark);
  }

  .price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-green);
    margin: 1rem 0;
  }

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  .how-it-works {
    padding: 5rem 0;
    background: var(--section-light);
    color: var(--text-dark);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
  }

  .step {
    text-align: center;
    background: #fff;
    color: var(--text-dark);
    border-radius: 15px;
    padding: 2rem 1rem;
  }

  .step-number {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--primary-green);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    margin: 0 auto 1rem;
  }

  .step-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .referral-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, var(--primary-green) 0%, #2c5f2d 100%);
    color: white;
  }

  .referral-content {
    text-align: center;
  }

  .referral-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .referral-step {
    background: rgba(245,230,211,0.7);
    padding: 2rem;
    border-radius: 15px;
    backdrop-filter: blur(10px);
    color: var(--text-dark);
  }

  .cta.gold {
    background: var(--gold);
    color: var(--text-dark);
  }

  .cta.gold:hover {
    background: #ffcc00;
  }

  .toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: var(--primary-green);
    color: white;
    padding: 1rem 2rem;
    border-radius: 10px;
    z-index: 1000;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }
    
    .hero-content {
      margin-bottom: 3rem;
    }
    
    .featured-grid {
      grid-template-columns: 1fr;
    }
    
    .steps {
      grid-template-columns: 1fr;
    }
    
    .referral-steps {
      grid-template-columns: 1fr;
    }
    
    .site-header .container, .site-footer .container {
      flex-direction: column;
      text-align: center;
    }
    .nav {
      flex-direction: column;
      gap: 0.5rem;
    }
    .nav a {
      margin: 0.5rem 0;
      width: 100%;
    }
    .cart-icon {
      margin: 1rem 0 0 0;
    }
    .footer-content {
      flex-direction: column;
      gap: 2rem;
    }
    .footer-section {
      margin-bottom: 2rem;
    }
    .newsletter input[type="email"] {
      width: 100%;
      margin-bottom: 0.5rem;
    }
    .newsletter button {
      width: 100%;
    }
  }
</style>
