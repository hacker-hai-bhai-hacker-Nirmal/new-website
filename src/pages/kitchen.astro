  <!-- Notification Sound -->
  <audio id="notificationSound" preload="auto">
    <source src="data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBSuBzvLZiTYIG2m98OScTgwOUarm7blmGgU7k9n1unEiBC13yO/eizEIHWq+8+OWT" type="audio/wav">
  </audio>

  <script>
    // Time display
    function updateTime() {
      const now = new Date();
      const timeString = now.toLocaleTimeString('en-US', { 
        hour: 'numeric', 
        minute: '2-digit',
        hour12: true 
      });
      document.getElementById('currentTime').textContent = timeString;
    }
    
    setInterval(updateTime, 1000);
    updateTime();

    // Tab switching
    const tabButtons = document.querySelectorAll('.tab-btn');
    const ordersGrids = {
      pending: document.getElementById('pendingOrders'),
      preparing: document.getElementById('preparingOrders'),
      ready: document.getElementById('readyOrders')
    };

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const status = btn.dataset.status;
        
        // Update active tab
        tabButtons.forEach(tab => tab.classList.remove('active'));
        btn.classList.add('active');
        
        // Show corresponding orders grid
        Object.values(ordersGrids).forEach(grid => {
          grid.style.display = 'none';
        });
        ordersGrids[status].style.display = 'grid';
      });
    });

    // Timer functionality
    function updateTimers() {
      document.querySelectorAll('.order-timer').forEach(timer => {
        const startTime = timer.dataset.startTime;
        if (startTime) {
          const [hours, minutes] = startTime.split(':').map(Number);
          const startDateTime = new Date();
          startDateTime.setHours(hours, minutes, 0, 0);
          
          const now = new Date();
          const elapsed = Math.floor((now - startDateTime) / 1000); // seconds
          const displayMinutes = Math.floor(elapsed / 60);
          const displaySeconds = elapsed % 60;
          
          timer.querySelector('.timer-display').textContent = 
            `${displayMinutes.toString().padStart(2, '0')}:${displaySeconds.toString().padStart(2, '0')}`;
          
          // Update progress ring
          const progressRing = timer.querySelector('.progress-ring');
          const progress = (elapsed % 1800) / 1800; // 30 minutes max
          const circumference = 2 * Math.PI * 45;
          const offset = circumference - (progress * circumference);
          progressRing.style.strokeDashoffset = offset;
        }
      });
    }

    setInterval(updateTimers, 1000);
    updateTimers();

    // Order actions
    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('start-preparing')) {
        const orderCard = e.target.closest('.order-card');
        const orderId = orderCard.dataset.orderId;
        
        // Move order to preparing
        orderCard.classList.remove('pending');
        orderCard.classList.add('preparing');
        orderCard.querySelector('.action-btn.start-preparing').textContent = 'Mark Ready';
        orderCard.querySelector('.action-btn.start-preparing').classList.remove('start-preparing');
        orderCard.querySelector('.action-btn.start-preparing').classList.add('mark-ready');
        
        // Update counts
        updateOrderCounts();
        showToast('Order moved to preparing');
      }
      
      if (e.target.classList.contains('mark-ready')) {
        const orderCard = e.target.closest('.order-card');
        const orderId = orderCard.dataset.orderId;
        
        // Move order to ready
        orderCard.classList.remove('preparing');
        orderCard.classList.add('ready');
        orderCard.querySelector('.action-btn.mark-ready').textContent = 'Complete';
        orderCard.querySelector('.action-btn.mark-ready').classList.remove('mark-ready');
        orderCard.querySelector('.action-btn.mark-ready').classList.add('complete');
        
        // Update counts
        updateOrderCounts();
        showToast('Order marked as ready!');
        playNotificationSound();
      }
      
      if (e.target.classList.contains('complete')) {
        const orderCard = e.target.closest('.order-card');
        const orderId = orderCard.dataset.orderId;
        
        // Remove order with animation
        orderCard.style.transform = 'translateX(100%)';
        orderCard.style.opacity = '0';
        setTimeout(() => {
          orderCard.remove();
          updateOrderCounts();
        }, 300);
        
        showToast('Order completed!');
      }
      
      if (e.target.classList.contains('reject')) {
        if (confirm('Are you sure you want to reject this order?')) {
          const orderCard = e.target.closest('.order-card');
          orderCard.style.transform = 'translateX(-100%)';
          orderCard.style.opacity = '0';
          setTimeout(() => {
            orderCard.remove();
            updateOrderCounts();
          }, 300);
          
          showToast('Order rejected');
        }
      }
      
      if (e.target.classList.contains('notify')) {
        showToast('Staff notified!');
        playNotificationSound();
      }
      
      if (e.target.classList.contains('view-details')) {
        showToast('Order details view');
      }
    });

    // Update order counts
    function updateOrderCounts() {
      const pendingCount = document.querySelectorAll('.order-card.pending').length;
      const preparingCount = document.querySelectorAll('.order-card.preparing').length;
      const readyCount = document.querySelectorAll('.order-card.ready').length;
      
      document.getElementById('pendingCount').textContent = pendingCount;
      document.getElementById('preparingCount').textContent = preparingCount;
      document.getElementById('readyCount').textContent = readyCount;
      
      document.getElementById('pendingTabCount').textContent = pendingCount;
      document.getElementById('preparingTabCount').textContent = preparingCount;
      document.getElementById('readyTabCount').textContent = readyCount;
    }

    // Sound toggle
    let soundEnabled = true;
    document.getElementById('soundToggle').addEventListener('click', (e) => {
      soundEnabled = !soundEnabled;
      e.target.textContent = soundEnabled ? '🔊' : '🔇';
    });

    function playNotificationSound() {
      if (soundEnabled) {
        const audio = document.getElementById('notificationSound');
        audio.play().catch(e => console.log('Audio play failed:', e));
      }
    }

    // Refresh orders
    document.getElementById('refreshOrders').addEventListener('click', () => {
      showToast('Refreshing orders...');
      // Simulate refresh
      setTimeout(() => {
        showToast('Orders refreshed!');
      }, 1000);
    });

    // Simulate new orders
    function addNewOrder() {
      const pendingOrders = document.getElementById('pendingOrders');
      const orderNames = ['Edward Norton', 'Fiona Green', 'George Miller'];
      const orderItems = [
        { emoji: '🥐', name: 'Artisan Croissant', mods: 'Standard' },
        { emoji: '☕', name: 'Signature Coffee', mods: 'Iced' },
        { emoji: '🥗', name: 'Garden Salad', mods: 'No onions' }
      ];
      
      const newOrder = document.createElement('div');
      newOrder.className = 'order-card pending';
      newOrder.dataset.orderId = `ORD-2025-${Math.floor(Math.random() * 1000)}`;
      
      const now = new Date();
      const timeString = now.toLocaleTimeString('en-US', { 
        hour: 'numeric', 
        minute: '2-digit',
        hour12: true 
      });
      
      const randomItems = orderItems.slice(0, Math.floor(Math.random() * 3) + 1);
      
      newOrder.innerHTML = `
        <div class="order-header">
          <div class="order-info">
            <div class="order-number">#${newOrder.dataset.orderId}</div>
            <div class="order-time">${timeString}</div>
          </div>
          <div class="order-timer" data-start-time="${now.getHours()}:${now.getMinutes().toString().padStart(2, '0')}">
            <span class="timer-display">00:01</span>
            <div class="timer-progress">
              <div class="progress-ring"></div>
            </div>
          </div>
        </div>
        
        <div class="order-items">
          ${randomItems.map(item => `
            <div class="item-row">
              <div class="item-details">
                <span class="item-emoji">${item.emoji}</span>
                <div class="item-info">
                  <div class="item-name">${item.name}</div>
                  <div class="item-mods">${item.mods}</div>
                </div>
              </div>
              <div class="item-quantity">×${Math.floor(Math.random() * 2) + 1}</div>
            </div>
          `).join('')}
        </div>
        
        <div class="order-footer">
          <div class="customer-info">
            <div class="customer-name">${orderNames[Math.floor(Math.random() * orderNames.length)]}</div>
            <div class="order-type">📱 Delivery</div>
          </div>
          <div class="order-actions">
            <button class="action-btn start-preparing">Start Preparing</button>
            <button class="action-btn reject">Reject</button>
          </div>
        </div>
      `;
      
      pendingOrders.insertBefore(newOrder, pendingOrders.firstChild);
      updateOrderCounts();
      playNotificationSound();
      showToast('New order received!');
    }

    // Add new order every 45 seconds
    setInterval(addNewOrder, 45000);

    // Toast notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    // Initialize
    updateOrderCounts();
  </script>

  <style>
    :root {
      --primary-green: #1B4332;
      --cream-white: #F8F9FA;
      --gold: #FFD700;
      --text-dark: #2C3E50;
      --text-light: #6C757D;
      --border-light: #E9ECEF;
      --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      --shadow-hover: 0 8px 15px rgba(0, 0, 0, 0.2);
      --pending-color: #dc3545;
      --preparing-color: #fd7e14;
      --ready-color: #28a745;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: var(--text-dark);
      background: var(--cream-white);
      overflow: hidden;
    }

    /* Kitchen Header */
    .kitchen-header {
      background: var(--primary-green);
      color: white;
      padding: 15px 20px;
      box-shadow: var(--shadow);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: 0 auto;
    }

    .restaurant-info h1 {
      font-size: 24px;
      margin-bottom: 5px;
    }

    .current-time {
      font-size: 18px;
      font-weight: bold;
      color: var(--gold);
    }

    .header-stats {
      display: flex;
      gap: 30px;
    }

    .stat-item {
      text-align: center;
    }

    .stat-label {
      display: block;
      font-size: 12px;
      text-transform: uppercase;
      opacity: 0.8;
      margin-bottom: 5px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: bold;
      padding: 8px 16px;
      border-radius: 8px;
      min-width: 60px;
    }

    .stat-value.pending {
      background: var(--pending-color);
      color: white;
    }

    .stat-value.preparing {
      background: var(--preparing-color);
      color: white;
    }

    .stat-value.ready {
      background: var(--ready-color);
      color: white;
    }

    .header-actions {
      display: flex;
      gap: 15px;
    }

    .sound-toggle,
    .refresh-btn {
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      padding: 10px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 20px;
      transition: all 0.3s;
    }

    .sound-toggle:hover,
    .refresh-btn:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    /* Kitchen Main */
    .kitchen-main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px;
      height: calc(100vh - 80px);
      display: flex;
      flex-direction: column;
    }

    /* Status Tabs */
    .status-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      background: white;
      padding: 10px;
      border-radius: 12px;
      box-shadow: var(--shadow);
    }

    .tab-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 15px 20px;
      background: var(--cream-white);
      border: 2px solid transparent;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: bold;
    }

    .tab-btn:hover {
      background: #e9ecef;
    }

    .tab-btn.active {
      background: var(--primary-green);
      color: white;
      border-color: var(--primary-green);
    }

    .tab-icon {
      font-size: 20px;
    }

    .tab-label {
      font-size: 16px;
    }

    .tab-count {
      background: rgba(255, 255, 255, 0.3);
      padding: 4px 8px;
      border-radius: 12px;
      font-size: 14px;
      min-width: 24px;
      text-align: center;
    }

    .tab-btn.active .tab-count {
      background: rgba(255, 255, 255, 0.3);
    }

    /* Orders Container */
    .orders-container {
      flex: 1;
      overflow-y: auto;
    }

    .orders-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
      gap: 20px;
      align-content: start;
    }

    /* Order Cards */
    .order-card {
      background: white;
      border-radius: 16px;
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: all 0.3s;
      border-left: 5px solid transparent;
    }

    .order-card.pending {
      border-left-color: var(--pending-color);
    }

    .order-card.preparing {
      border-left-color: var(--preparing-color);
    }

    .order-card.ready {
      border-left-color: var(--ready-color);
    }

    .order-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    /* Order Header */
    .order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
      background: var(--cream-white);
      border-bottom: 1px solid var(--border-light);
    }

    .order-info {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .order-number {
      font-size: 18px;
      font-weight: bold;
      color: var(--primary-green);
    }

    .order-time {
      font-size: 14px;
      color: var(--text-light);
    }

    .order-timer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }

    .timer-display {
      font-size: 16px;
      font-weight: bold;
      color: var(--text-dark);
    }

    .timer-progress {
      width: 50px;
      height: 50px;
    }

    .progress-ring {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 4px solid #e9ecef;
      border-top-color: var(--pending-color);
      animation: spin 2s linear infinite;
    }

    .order-card.preparing .progress-ring {
      border-top-color: var(--preparing-color);
    }

    .order-card.ready .progress-ring {
      border-top-color: var(--ready-color);
      animation: none;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Order Items */
    .order-items {
      padding: 20px;
    }

    .item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--border-light);
    }

    .item-row:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .item-details {
      display: flex;
      align-items: center;
      gap: 15px;
      flex: 1;
    }

    .item-emoji {
      font-size: 24px;
      min-width: 30px;
    }

    .item-info {
      flex: 1;
    }

    .item-name {
      font-weight: bold;
      color: var(--text-dark);
      margin-bottom: 2px;
    }

    .item-mods {
      font-size: 12px;
      color: var(--text-light);
      font-style: italic;
    }

    .item-quantity {
      font-size: 18px;
      font-weight: bold;
      color: var(--primary-green);
      min-width: 40px;
      text-align: right;
    }

    /* Order Footer */
    .order-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
      background: var(--cream-white);
      border-top: 1px solid var(--border-light);
    }

    .customer-info {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .customer-name {
      font-weight: bold;
      color: var(--text-dark);
    }

    .order-type {
      font-size: 14px;
      color: var(--text-light);
    }

    .order-actions {
      display: flex;
      gap: 10px;
    }

    .action-btn {
      background: var(--primary-green);
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s;
      font-size: 14px;
    }

    .action-btn:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow);
    }

    .action-btn.reject {
      background: var(--pending-color);
    }

    .action-btn.mark-ready {
      background: var(--preparing-color);
    }

    .action-btn.complete {
      background: var(--ready-color);
    }

    .action-btn.notify {
      background: var(--gold);
      color: var(--primary-green);
    }

    .action-btn.view-details {
      background: var(--text-light);
    }

    /* Toast Notification */
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--primary-green);
      color: white;
      padding: 15px 20px;
      border-radius: 8px;
      box-shadow: var(--shadow-hover);
      z-index: 1000;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    /* Responsive for tablets */
    @media (max-width: 1200px) {
      .orders-grid {
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .header-content {
        flex-direction: column;
        gap: 15px;
      }

      .header-stats {
        order: 3;
      }

      .kitchen-main {
        padding: 10px;
      }

      .orders-grid {
        grid-template-columns: 1fr;
      }

      .status-tabs {
        flex-direction: column;
      }

      .tab-btn {
        justify-content: flex-start;
      }
    }

    /* Scrollbar styling */
    .orders-container::-webkit-scrollbar {
      width: 8px;
    }

    .orders-container::-webkit-scrollbar-track {
      background: var(--cream-white);
    }

    .orders-container::-webkit-scrollbar-thumb {
      background: var(--border-light);
      border-radius: 4px;
    }

    .orders-container::-webkit-scrollbar-thumb:hover {
      background: var(--text-light);
    }
  </style>
</Layout>
