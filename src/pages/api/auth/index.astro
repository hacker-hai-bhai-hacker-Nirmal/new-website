---
// Authentication API Documentation and Status Endpoint
// GET /api/auth
// Provides comprehensive documentation for the authentication system
// Updated: 2025-11-30 - Testing deployment

export async function GET() {
  return Response.json({
    success: true,
    title: "Role-Based Authentication API",
    version: "1.0.0",
    description: "Complete authentication system with role-based access control",
    
    endpoints: {
      "POST /api/auth/register": {
        description: "Register new user with role",
        requiredFields: ["email", "firstName", "lastName", "role"],
        optionalFields: ["phone", "restaurantId"],
        supportedRoles: ["customer", "delivery_partner", "restaurant_staff"],
        returns: ["user", "otpToken", "message"]
      },
      
      "POST /api/auth/verify-otp": {
        description: "Verify OTP and get JWT tokens",
        requiredFields: ["email", "otp", "otpToken"],
        returns: ["user", "accessToken", "refreshToken", "expiresIn"]
      },
      
      "POST /api/auth/refresh": {
        description: "Refresh access token",
        requiredFields: ["refreshToken"],
        returns: ["accessToken", "expiresIn"]
      },
      
      "GET /api/auth/me": {
        description: "Get current user information",
        requiresAuth: true,
        returns: ["user", "permissions"]
      },
      
      "POST /api/auth/logout": {
        description: "Logout user",
        requiresAuth: true,
        returns: ["message"]
      },
      
      "GET /api/auth": {
        description: "Complete API documentation",
        returns: ["documentation"]
      }
    },

    roles: {
      customer: {
        description: "Regular customers who can place orders",
        permissions: ["profile", "orders", "rewards", "menu"],
        routes: ["/dashboard", "/checkout", "/rewards", "/menu", "/profile"]
      },
      
      delivery_partner: {
        description: "Handle order deliveries",
        permissions: ["profile", "delivery", "orders", "kitchen"],
        routes: ["/dashboard", "/delivery", "/kitchen", "/profile"]
      },
      
      restaurant_staff: {
        description: "Manage kitchen and restaurant operations",
        permissions: ["profile", "kitchen", "menu", "orders"],
        routes: ["/dashboard", "/kitchen", "/menu", "/orders", "/profile"]
      },
      
      admin: {
        description: "System administrators",
        permissions: ["full_system_access"],
        routes: ["all_routes"]
      }
    },

    status: {
      authentication: "JWT-based with role permissions",
      deployment: "Cloudflare Pages Functions",
      environment: "Production",
      lastUpdated: "2025-11-30"
    }
  });
}

export async function POST() {
  return Response.json({
    success: false,
    error: "POST method not supported on this endpoint",
    message: "Use the specific authentication endpoints for POST requests"
  }, { status: 405 });
}
---
