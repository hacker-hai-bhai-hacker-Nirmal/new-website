---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <header class="admin-header">
    <div class="header-content">
      <div class="logo">
        <h1>Litterateur Admin</h1>
      </div>
      <div class="header-actions">
        <button class="refresh-btn" id="refreshData">🔄 Refresh</button>
        <div class="admin-info">
          <span>Admin User</span>
          <button class="logout-btn">Logout</button>
        </div>
      </div>
    </div>
  </header>

  <div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar">
      <nav class="sidebar-nav">
        <a href="#dashboard" class="nav-item active">
          <span class="nav-icon">📊</span>
          <span>Dashboard Home</span>
        </a>
        <a href="#orders" class="nav-item">
          <span class="nav-icon">📋</span>
          <span>Orders</span>
        </a>
        <a href="#menu" class="nav-item">
          <span class="nav-icon">🍽️</span>
          <span>Menu Items</span>
        </a>
        <a href="#delivery" class="nav-item">
          <span class="nav-icon">🚚</span>
          <span>Delivery Partners</span>
        </a>
        <a href="#customers" class="nav-item">
          <span class="nav-icon">👥</span>
          <span>Customers</span>
        </a>
        <a href="#analytics" class="nav-item">
          <span class="nav-icon">📈</span>
          <span>Analytics</span>
        </a>
        <a href="#settings" class="nav-item">
          <span class="nav-icon">⚙️</span>
          <span>Settings</span>
        </a>
      </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main">
      <!-- Dashboard Home -->
      <section id="dashboard" class="content-section active">
        <h2>Dashboard Overview</h2>
        
        <!-- Key Metrics -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="metric-icon">📦</div>
            <div class="metric-content">
              <div class="metric-value" id="ordersToday">47</div>
              <div class="metric-label">Orders Today</div>
              <div class="metric-change positive">+12% from yesterday</div>
            </div>
          </div>
          
          <div class="metric-card">
            <div class="metric-icon">💰</div>
            <div class="metric-content">
              <div class="metric-value" id="revenueToday">₹18,450</div>
              <div class="metric-label">Revenue Today</div>
              <div class="metric-change positive">+8% from yesterday</div>
            </div>
          </div>
          
          <div class="metric-card">
            <div class="metric-icon">👥</div>
            <div class="metric-content">
              <div class="metric-value" id="activeUsers">312</div>
              <div class="metric-label">Active Users</div>
              <div class="metric-change positive">+5% from last hour</div>
            </div>
          </div>
          
          <div class="metric-card">
            <div class="metric-icon">🚚</div>
            <div class="metric-content">
              <div class="metric-value" id="deliveryTime">28min</div>
              <div class="metric-label">Avg Delivery Time</div>
              <div class="metric-change negative">+3min from target</div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions-section">
          <h3>Quick Actions</h3>
          <div class="quick-actions">
            <button class="action-btn primary">📋 View All Orders</button>
            <button class="action-btn secondary">🍽️ Add Menu Item</button>
            <button class="action-btn secondary">🚚 Manage Delivery</button>
            <button class="action-btn secondary">📊 Generate Report</button>
          </div>
        </div>

        <!-- Live Orders Feed -->
        <div class="live-orders-section">
          <h3>Live Orders Feed</h3>
          <div class="orders-feed" id="ordersFeed">
            <div class="order-item new">
              <div class="order-time">2 mins ago</div>
              <div class="order-details">
                <div class="order-number">#ORD-2025-048</div>
                <div class="order-customer">John Doe</div>
                <div class="order-items">🥐×2, ☕×1</div>
                <div class="order-total">₹794</div>
              </div>
              <div class="order-status-badge new">NEW</div>
            </div>
            
            <div class="order-item">
              <div class="order-time">5 mins ago</div>
              <div class="order-details">
                <div class="order-number">#ORD-2025-047</div>
                <div class="order-customer">Jane Smith</div>
                <div class="order-items">🥗×1, 🍮×1</div>
                <div class="order-total">₹598</div>
              </div>
              <div class="order-status-badge preparing">PREPARING</div>
            </div>
            
            <div class="order-item">
              <div class="order-time">8 mins ago</div>
              <div class="order-details">
                <div class="order-number">#ORD-2025-046</div>
                <div class="order-customer">Bob Wilson</div>
                <div class="order-items">🥩×1, 🍷×1</div>
                <div class="order-total">₹1,248</div>
              </div>
              <div class="order-status-badge ready">READY</div>
            </div>
          </div>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
          <div class="chart-container">
            <h3>Revenue Overview</h3>
            <div class="chart-placeholder">
              <div class="chart-icon">📈</div>
              <p>Revenue graph showing daily, weekly, monthly trends</p>
              <div class="chart-mock">
                <div class="bar" style="height: 60%"></div>
                <div class="bar" style="height: 80%"></div>
                <div class="bar" style="height: 45%"></div>
                <div class="bar" style="height: 90%"></div>
                <div class="bar" style="height: 70%"></div>
                <div class="bar" style="height: 85%"></div>
                <div class="bar" style="height: 95%"></div>
              </div>
            </div>
          </div>
          
          <div class="chart-container">
            <h3>Top Selling Items</h3>
            <div class="chart-placeholder">
              <div class="chart-icon">🍽️</div>
              <p>Bar chart showing most popular menu items</p>
              <div class="top-items">
                <div class="item-bar">
                  <span>Artisan Croissant</span>
                  <div class="bar-fill" style="width: 90%"></div>
                  <span>234</span>
                </div>
                <div class="item-bar">
                  <span>Signature Coffee</span>
                  <div class="bar-fill" style="width: 85%"></div>
                  <span>198</span>
                </div>
                <div class="item-bar">
                  <span>Garden Salad</span>
                  <div class="bar-fill" style="width: 70%"></div>
                  <span>156</span>
                </div>
                <div class="item-bar">
                  <span>Grilled Ribeye</span>
                  <div class="bar-fill" style="width: 65%"></div>
                  <span>142</span>
                </div>
                <div class="item-bar">
                  <span>Chocolate Lava Cake</span>
                  <div class="bar-fill" style="width: 55%"></div>
                  <span>98</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Orders Management -->
      <section id="orders" class="content-section">
        <h2>Orders Management</h2>
        <div class="orders-table-container">
          <table class="orders-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Time</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>#ORD-2025-048</td>
                <td>John Doe</td>
                <td>🥐×2, ☕×1</td>
                <td>₹794</td>
                <td><span class="status-badge new">New</span></td>
                <td>2 mins ago</td>
                <td>
                  <button class="action-btn-small">View</button>
                  <button class="action-btn-small">Process</button>
                </td>
              </tr>
              <tr>
                <td>#ORD-2025-047</td>
                <td>Jane Smith</td>
                <td>🥗×1, 🍮×1</td>
                <td>₹598</td>
                <td><span class="status-badge preparing">Preparing</span></td>
                <td>5 mins ago</td>
                <td>
                  <button class="action-btn-small">View</button>
                  <button class="action-btn-small">Update</button>
                </td>
              </tr>
              <tr>
                <td>#ORD-2025-046</td>
                <td>Bob Wilson</td>
                <td>🥩×1, 🍷×1</td>
                <td>₹1,248</td>
                <td><span class="status-badge ready">Ready</span></td>
                <td>8 mins ago</td>
                <td>
                  <button class="action-btn-small">View</button>
                  <button class="action-btn-small">Assign</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Menu Management -->
      <section id="menu" class="content-section">
        <h2>Menu Management</h2>
        <div class="menu-controls">
          <button class="action-btn primary">+ Add New Item</button>
          <div class="filter-controls">
            <select class="filter-select">
              <option>All Categories</option>
              <option>Breakfast</option>
              <option>Lunch</option>
              <option>Dinner</option>
              <option>Beverages</option>
              <option>Desserts</option>
            </select>
            <input type="text" class="search-input" placeholder="Search menu items...">
          </div>
        </div>
        
        <div class="menu-grid">
          <div class="menu-item-card">
            <div class="item-image">🥐</div>
            <div class="item-details">
              <h4>Artisan Croissant</h4>
              <p>Buttery, flaky perfection with premium French butter</p>
              <div class="item-price">₹299</div>
              <div class="item-category">Breakfast</div>
              <div class="item-status">
                <span class="status-badge active">Available</span>
                <span class="badge bestseller">Bestseller</span>
              </div>
            </div>
            <div class="item-actions">
              <button class="action-btn-small">Edit</button>
              <button class="action-btn-small">Toggle</button>
            </div>
          </div>
          
          <div class="menu-item-card">
            <div class="item-image">☕</div>
            <div class="item-details">
              <h4>Signature Blend Coffee</h4>
              <p>Single-origin beans with chocolate and caramel notes</p>
              <div class="item-price">₹199</div>
              <div class="item-category">Beverages</div>
              <div class="item-status">
                <span class="status-badge active">Available</span>
                <span class="badge bestseller">Bestseller</span>
              </div>
            </div>
            <div class="item-actions">
              <button class="action-btn-small">Edit</button>
              <button class="action-btn-small">Toggle</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Other sections would be similar... -->
    </main>
  </div>

  <script>
    // Navigation
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Remove active class from all items and sections
        document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
        document.querySelectorAll('.content-section').forEach(section => section.classList.remove('active'));
        
        // Add active class to clicked item
        item.classList.add('active');
        
        // Show corresponding section
        const targetId = item.getAttribute('href').substring(1);
        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          targetSection.classList.add('active');
        }
      });
    });

    // Refresh data
    document.getElementById('refreshData').addEventListener('click', () => {
      showToast('Refreshing dashboard data...');
      
      // Simulate data refresh
      setTimeout(() => {
        // Update metrics with random changes
        const ordersToday = document.getElementById('ordersToday');
        const currentOrders = parseInt(ordersToday.textContent);
        ordersToday.textContent = currentOrders + Math.floor(Math.random() * 3);
        
        const revenueToday = document.getElementById('revenueToday');
        const currentRevenue = parseInt(revenueToday.textContent.replace('₹', '').replace(',', ''));
        revenueToday.textContent = '₹' + (currentRevenue + Math.floor(Math.random() * 1000)).toLocaleString();
        
        showToast('Data refreshed successfully!');
      }, 1500);
    });

    // Live orders simulation
    function addNewOrder() {
      const ordersFeed = document.getElementById('ordersFeed');
      const orderNames = ['Alice Johnson', 'Charlie Brown', 'Diana Prince', 'Edward Norton', 'Fiona Green'];
      const orderItems = ['🥐×1', '☕×2', '🥗×1', '🥩×1', '🍮×2'];
      
      const newOrder = document.createElement('div');
      newOrder.className = 'order-item new';
      newOrder.innerHTML = `
        <div class="order-time">Just now</div>
        <div class="order-details">
          <div class="order-number">#ORD-2025-${Math.floor(Math.random() * 1000)}</div>
          <div class="order-customer">${orderNames[Math.floor(Math.random() * orderNames.length)]}</div>
          <div class="order-items">${orderItems[Math.floor(Math.random() * orderItems.length)]}</div>
          <div class="order-total">₹${Math.floor(Math.random() * 1000) + 200}</div>
        </div>
        <div class="order-status-badge new">NEW</div>
      `;
      
      ordersFeed.insertBefore(newOrder, ordersFeed.firstChild);
      
      // Remove the 'new' class after 5 seconds
      setTimeout(() => {
        newOrder.classList.remove('new');
      }, 5000);
      
      // Keep only last 5 orders
      while (ordersFeed.children.length > 5) {
        ordersFeed.removeChild(ordersFeed.lastChild);
      }
    }

    // Simulate new orders every 10 seconds
    setInterval(addNewOrder, 10000);

    // Quick actions
    document.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.textContent.trim();
        showToast(`Executing: ${action}`);
      });
    });

    // Toast notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    // Auto-refresh metrics every 30 seconds
    setInterval(() => {
      const activeUsers = document.getElementById('activeUsers');
      const currentUsers = parseInt(activeUsers.textContent);
      const change = Math.floor(Math.random() * 21) - 10; // -10 to +10
      activeUsers.textContent = Math.max(250, currentUsers + change);
    }, 30000);
  </script>

  <style>
    :root {
      --primary-green: #1B4332;
      --cream-white: #F8F9FA;
      --gold: #FFD700;
      --text-dark: #2C3E50;
      --text-light: #6C757D;
      --border-light: #E9ECEF;
      --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      --shadow-hover: 0 8px 15px rgba(0, 0, 0, 0.2);
      --dark-bg: #1a1a1a;
      --dark-surface: #2d2d2d;
      --dark-border: #404040;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: var(--text-dark);
      background: var(--dark-bg);
    }

    /* Admin Header */
    .admin-header {
      background: var(--dark-surface);
      border-bottom: 1px solid var(--dark-border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 30px;
    }

    .logo h1 {
      color: var(--gold);
      font-size: 24px;
      font-weight: bold;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .refresh-btn {
      background: var(--primary-green);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: bold;
    }

    .refresh-btn:hover {
      background: #2A5F3E;
      transform: translateY(-2px);
    }

    .admin-info {
      display: flex;
      align-items: center;
      gap: 15px;
      color: white;
    }

    .logout-btn {
      background: #dc3545;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.3s;
    }

    .logout-btn:hover {
      background: #c82333;
    }

    /* Admin Layout */
    .admin-layout {
      display: flex;
      height: calc(100vh - 70px);
    }

    /* Sidebar */
    .admin-sidebar {
      width: 250px;
      background: var(--dark-surface);
      border-right: 1px solid var(--dark-border);
      overflow-y: auto;
    }

    .sidebar-nav {
      padding: 20px 0;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px 25px;
      color: #b0b0b0;
      text-decoration: none;
      transition: all 0.3s;
      border-left: 3px solid transparent;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
    }

    .nav-item.active {
      background: rgba(255, 215, 0, 0.1);
      color: var(--gold);
      border-left-color: var(--gold);
    }

    .nav-icon {
      font-size: 20px;
      min-width: 20px;
    }

    /* Main Content */
    .admin-main {
      flex: 1;
      background: var(--dark-bg);
      overflow-y: auto;
      padding: 30px;
    }

    .content-section {
      display: none;
    }

    .content-section.active {
      display: block;
    }

    .content-section h2 {
      color: white;
      font-size: 32px;
      margin-bottom: 30px;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      margin-bottom: 40px;
    }

    .metric-card {
      background: var(--dark-surface);
      border: 1px solid var(--dark-border);
      border-radius: 12px;
      padding: 25px;
      display: flex;
      align-items: center;
      gap: 20px;
      transition: all 0.3s;
    }

    .metric-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .metric-icon {
      font-size: 40px;
      min-width: 50px;
    }

    .metric-value {
      font-size: 32px;
      font-weight: bold;
      color: white;
      margin-bottom: 5px;
    }

    .metric-label {
      color: #b0b0b0;
      font-size: 14px;
      margin-bottom: 5px;
    }

    .metric-change {
      font-size: 12px;
      font-weight: bold;
    }

    .metric-change.positive {
      color: #28a745;
    }

    .metric-change.negative {
      color: #dc3545;
    }

    /* Quick Actions */
    .quick-actions-section {
      margin-bottom: 40px;
    }

    .quick-actions-section h3 {
      color: white;
      font-size: 20px;
      margin-bottom: 20px;
    }

    .quick-actions {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .action-btn {
      background: var(--primary-green);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: bold;
    }

    .action-btn:hover {
      background: #2A5F3E;
      transform: translateY(-2px);
    }

    .action-btn.secondary {
      background: transparent;
      color: white;
      border: 2px solid var(--dark-border);
    }

    .action-btn.secondary:hover {
      border-color: var(--primary-green);
      background: rgba(27, 67, 50, 0.3);
    }

    /* Live Orders Feed */
    .live-orders-section {
      margin-bottom: 40px;
    }

    .live-orders-section h3 {
      color: white;
      font-size: 20px;
      margin-bottom: 20px;
    }

    .orders-feed {
      background: var(--dark-surface);
      border: 1px solid var(--dark-border);
      border-radius: 12px;
      padding: 20px;
      max-height: 400px;
      overflow-y: auto;
    }

    .order-item {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 15px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      margin-bottom: 10px;
      transition: all 0.3s;
    }

    .order-item.new {
      background: rgba(255, 215, 0, 0.1);
      border: 1px solid var(--gold);
    }

    .order-time {
      color: #b0b0b0;
      font-size: 12px;
      min-width: 80px;
    }

    .order-details {
      flex: 1;
    }

    .order-number {
      color: white;
      font-weight: bold;
      margin-bottom: 2px;
    }

    .order-customer {
      color: #b0b0b0;
      font-size: 14px;
      margin-bottom: 2px;
    }

    .order-items {
      color: white;
      font-size: 14px;
      margin-bottom: 2px;
    }

    .order-total {
      color: var(--gold);
      font-weight: bold;
    }

    .order-status-badge {
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
      min-width: 80px;
      text-align: center;
    }

    .order-status-badge.new {
      background: var(--gold);
      color: var(--primary-green);
    }

    .order-status-badge.preparing {
      background: #17a2b8;
      color: white;
    }

    .order-status-badge.ready {
      background: #28a745;
      color: white;
    }

    /* Charts Section */
    .charts-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .chart-container {
      background: var(--dark-surface);
      border: 1px solid var(--dark-border);
      border-radius: 12px;
      padding: 25px;
    }

    .chart-container h3 {
      color: white;
      font-size: 18px;
      margin-bottom: 20px;
    }

    .chart-placeholder {
      text-align: center;
      color: #b0b0b0;
    }

    .chart-icon {
      font-size: 48px;
      margin-bottom: 15px;
    }

    .chart-mock {
      display: flex;
      align-items: end;
      justify-content: space-around;
      height: 150px;
      margin-top: 20px;
    }

    .bar {
      width: 30px;
      background: var(--primary-green);
      border-radius: 4px 4px 0 0;
      transition: all 0.3s;
    }

    .bar:hover {
      background: var(--gold);
    }

    .top-items {
      margin-top: 20px;
    }

    .item-bar {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 15px;
    }

    .item-bar span:first-child {
      min-width: 150px;
      text-align: left;
    }

    .bar-fill {
      height: 20px;
      background: var(--primary-green);
      border-radius: 10px;
      min-width: 20px;
      transition: all 0.3s;
    }

    .bar-fill:hover {
      background: var(--gold);
    }

    .item-bar span:last-child {
      min-width: 40px;
      text-align: right;
      font-weight: bold;
      color: white;
    }

    /* Orders Table */
