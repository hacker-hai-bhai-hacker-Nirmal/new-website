---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Launch Discount Banner -->
  <div class="discount-banner">
    <div class="sparkle-effect">✨</div>
    <span>🎉 Launch Discount: Get Up to 60% Off! 🎉</span>
    <div class="sparkle-effect">✨</div>
  </div>

  <header class="site-header">
    <div class="container">
      <a class="brand" href="/">Litterateur</a>
      <div class="auth-form-container">
        <div class="deploy-timestamp" style="margin-bottom:16px;color:#888;font-size:14px;text-align:right;">
          Deployment Timestamp: {new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' })}
        </div>
        <!-- Phone Auth Form -->
        <form id="phoneForm" class="phone-form">
          <div class="form-group">
            <label for="phoneNumber">Phone Number</label>
            <input type="tel" id="phoneNumber" name="phoneNumber" placeholder="+1 555-555-5555" required />
          </div>
          <div id="recaptcha-container"></div>
          <button type="button" id="sendOtpBtn" class="primary-btn">Send OTP</button>
          <div id="otpSection" style="display:none; margin-top:20px;">
            <div class="form-group">
              <label for="otpCode">Enter OTP</label>
              <input type="text" id="otpCode" name="otpCode" maxlength="6" required />
            </div>
            <button type="button" id="verifyOtpBtn" class="primary-btn">Verify & Sign In</button>
          </div>
          <div id="phoneError" style="color:var(--error-red);margin-top:10px;"></div>
        </form>
        <!-- redeploy trigger: 2025-12-24 -->
        <!-- Firebase App (the core Firebase SDK) -->
        <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
        <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
        <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
        <!-- Inline Firebase logic: must come after all CDN scripts -->
        <script is:inline>
          // Firebase config (public, safe for client)
          const firebaseConfig = {
            apiKey: "AIzaSyB8tgve3Kp1iTSia65hggHdiRrMerlFw9o",
            authDomain: "litterateur-e0a3c.firebaseapp.com",
            projectId: "litterateur-e0a3c",
            storageBucket: "litterateur-e0a3c.firebasestorage.app",
            messagingSenderId: "720445027014",
            appId: "1:720445027014:web:bf1d60c9a2a3f93c675dc7",
            measurementId: "G-JM0F9W1H40"
          };
          firebase.initializeApp(firebaseConfig);
          const auth = firebase.auth();
          const db = firebase.firestore();
          let confirmationResult = null;
          window.addEventListener('DOMContentLoaded', () => {
            // Setup reCAPTCHA
            window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
              'size': 'invisible',
              'callback': (response) => {
                // reCAPTCHA solved
              }
            }, auth);

            document.getElementById('sendOtpBtn').onclick = async () => {
              const phoneInput = document.getElementById('phoneNumber');
              const phone = phoneInput.value;
              const errorDiv = document.getElementById('phoneError');
              errorDiv.textContent = "";
              if (!phone) {
                errorDiv.textContent = "Please enter a valid phone number.";
                return;
              }
              try {
                confirmationResult = await auth.signInWithPhoneNumber(phone, window.recaptchaVerifier);
                document.getElementById('otpSection').style.display = 'block';
                errorDiv.textContent = "OTP sent! Please check your phone.";
              } catch (err) {
                errorDiv.textContent = err.message;
              }
            };

            document.getElementById('verifyOtpBtn').onclick = async () => {
              const otpInput = document.getElementById('otpCode');
              const otp = otpInput.value;
              const errorDiv = document.getElementById('phoneError');
              errorDiv.textContent = "";
              if (!otp || !confirmationResult) {
                errorDiv.textContent = "Please enter the OTP sent to your phone.";
                return;
              }
              try {
                const result = await confirmationResult.confirm(otp);
                const user = result.user;
                // Create user doc if not exists
                const userDoc = await db.collection("users").doc(user.uid).get();
                if (!userDoc.exists) {
                  await db.collection("users").doc(user.uid).set({
                    phone: user.phoneNumber,
                    role: "customer",
                    createdAt: new Date().toISOString()
                  });
                }
                // Redirect based on role
                const role = userDoc.exists ? userDoc.data().role : "customer";
                if (role === "admin") {
                  window.location.href = "/admin";
                } else {
                  window.location.href = "/dashboard";
                }
              } catch (err) {
                errorDiv.textContent = err.message;
              }
            };
          });
        </script>
        </script>
      </div> <!-- end .auth-form-container -->
      </div> <!-- end .auth-container -->
    </div> <!-- end .container -->
  </section>
</main>
</Layout>

<style>
  /* Discount Banner */
  .discount-banner {
    background: linear-gradient(45deg, var(--gold), #FFA500);
    color: var(--primary-green);
    text-align: center;
    padding: 12px;
    font-weight: bold;
    font-size: 18px;
    position: relative;
    overflow: hidden;
  }

  .sparkle-effect {
    display: inline-block;
    animation: sparkle 2s infinite;
  }

  @keyframes sparkle {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  /* Header */
  .site-header {
    background: white;
    box-shadow: var(--shadow);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
  }

  .brand {
    font-size: 28px;
    font-weight: bold;
    color: var(--primary-green);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav a {
    text-decoration: none;
    color: var(--text-dark);
    font-weight: 500;
    transition: color 0.3s;
  }

  .nav a:hover {
    color: var(--primary-green);
  }

  .nav .cta {
    background: var(--primary-green);
    color: white;
    padding: 8px 16px;
    border-radius: 25px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .nav .cta:hover {
    background: #2c5f2d;
    transform: translateY(-2px);
  }

  /* Auth Section */
  .auth-section {
    padding: 80px 0;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
  }

  .auth-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .auth-image {
    position: relative;
  }

  .image-placeholder {
    height: 400px;
    background: linear-gradient(135deg, var(--primary-green), #2c5f2d);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: white;
    box-shadow: var(--shadow-hover);
  }

  .auth-form-container {
    background: white;
    padding: 40px;
    border-radius: 20px;
    box-shadow: var(--shadow-hover);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .auth-header h1 {
    font-size: 2.5rem;
    color: var(--primary-green);
    margin-bottom: 10px;
  }

  .auth-header p {
    color: var(--text-light);
    font-size: 1.1rem;
  }

  .auth-badge {
    background: linear-gradient(45deg, var(--primary-green), #2c5f2d);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 15px;
  }

  /* OTP Redirect Section */
  .otp-redirect {
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
  }

  .otp-info {
    margin-bottom: 40px;
  }

  .otp-icon {
    font-size: 4rem;
    margin-bottom: 20px;
    display: block;
  }

  .otp-info h2 {
    font-size: 1.8rem;
    color: var(--primary-green);
    margin-bottom: 15px;
  }

  .otp-info p {
    color: var(--text-light);
    margin-bottom: 30px;
    line-height: 1.6;
  }

  .otp-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }

  .benefit {
    text-align: center;
  }

  .benefit-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 10px;
  }

  .benefy span {
    font-size: 14px;
    color: var(--text-dark);
    font-weight: 600;
  }

  .redirect-action {
    margin-bottom: 30px;
  }

  .primary-btn {
    background: var(--primary-green);
    color: white;
    padding: 16px 32px;
    border: none;
    border-radius: 12px;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s;
    cursor: pointer;
  }

  .primary-btn:hover {
    background: #2c5f2d;
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .btn-icon {
    font-size: 20px;
  }

  .redirect-note {
    color: var(--text-light);
    font-size: 14px;
    margin-top: 15px;
  }

  /* Trust Badges */
  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 40px;
  }

  .trust-badge {
    text-align: center;
    flex: 1;
  }

  .trust-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 10px;
  }

  .trust-badge span {
    font-size: 14px;
    color: var(--text-dark);
    font-weight: 600;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .auth-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .auth-image {
      order: 2;
    }

    .auth-form-container {
      order: 1;
      padding: 30px 20px;
    }

    .image-placeholder {
      height: 300px;
    }

    .auth-header h1 {
      font-size: 2rem;
    }

    .nav {
      gap: 1rem;
    }

    .otp-benefits {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .trust-badges {
      flex-direction: column;
      gap: 20px;
    }
  }
</style>
