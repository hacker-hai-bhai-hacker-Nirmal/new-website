  <script>
    // Deployment Status Functions
    function updateDeploymentStatus() {
      const now = new Date();
      document.getElementById('pageLoaded').textContent = now.toLocaleString();
      
      // Simulate last deployment time (in real app, this would come from API)
      const lastDeployed = new Date('2025-11-26T18:20:00Z');
      document.getElementById('lastDeployed').textContent = lastDeployed.toLocaleString();
      
      // Check cache status
      checkCacheStatus();
    }

    function checkCacheStatus() {
      const cacheStatus = document.getElementById('cacheStatus');
      
      // Check if page was loaded from cache
      if (performance.getEntriesByType('navigation')[0].transferSize === 0) {
        cacheStatus.textContent = 'Served from cache';
        cacheStatus.style.color = '#f39c12';
      } else {
        cacheStatus.textContent = 'Fresh load';
        cacheStatus.style.color = '#27ae60';
      }
    }

    function checkDeploymentStatus() {
      const statusIndicator = document.getElementById('deploymentStatus');
      statusIndicator.textContent = 'Checking...';
      statusIndicator.className = 'status-indicator checking';
      
      // Simulate API call to check deployment status
      setTimeout(() => {
        statusIndicator.textContent = 'Online';
        statusIndicator.className = 'status-indicator online';
        updateDeploymentStatus();
        
        // Show success message
        showToast('Deployment status updated successfully!');
      }, 1000);
    }

    function clearCache() {
      if ('caches' in window) {
        caches.keys().then(function(names) {
          names.forEach(function(name) {
            caches.delete(name);
          });
        });
      }
      
      // Force reload with cache busting
      const url = new URL(window.location);
      url.searchParams.set('v', Date.now());
      window.location.href = url.toString();
    }

    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      
      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    // Initialize deployment status on page load
    document.addEventListener('DOMContentLoaded', function() {
      updateDeploymentStatus();
    });
  </script>
