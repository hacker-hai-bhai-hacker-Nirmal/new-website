# Appwrite Configuration
# Copy this file to .env and fill in your actual values

# Appwrite Project ID (required)
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Appwrite Endpoint (usually the default)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Database ID (will be created automatically)
VITE_APPWRITE_DATABASE_ID=litterateur_db

# For development, you can use Appwrite Cloud or self-hosted
# Get your Project ID from: https://cloud.appwrite.io/

# Example setup:
# 1. Go to https://cloud.appwrite.io/
# 2. Create a new project
# 3. Copy the Project ID
# 4. Replace 'your_project_id_here' with your actual Project ID
# 5. Run: npm run dev to test locally
# 6. Deploy to see it work in production
