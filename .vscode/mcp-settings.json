{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@ama-mcp/github"
      ],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}",
        "GITHUB_OWNER": "hacker-hai-bhai-hacker-Nirmal",
        "GITHUB_REPO": "new-website"
      },
      "description": "GitHub integration for repository, issues, PRs, and Actions management"
    },
    "cloudflare": {
      "command": "npx",
      "args": [
        "-y",
        "@thelord/mcp-cloudflare"
      ],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${env:CF_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "${env:CF_ACCOUNT_ID}"
      },
      "description": "Cloudflare DNS and Pages management"
    }
  }
}
